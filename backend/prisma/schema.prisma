generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Per docs/db.md in zest-support, `ingredients` is the simplest entity:
// a uuid PK and a name. No audit columns / ordering columns by design.
model Ingredient {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(255)

  @@map("ingredients")
}
